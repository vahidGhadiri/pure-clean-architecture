{
    "name": "pure-clean",
    "version": "0.1.0",
    "description": "A production-grade Clean Architecture CLI for scaffolding React applications",
    "type": "module",
    "bin": {
        "pure-clean": "./dist/main.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p templates/react/base/tsconfig.json",
        "dev": "tsx src/main.ts",
        "clean": "rm -rf dist",
        "lint:check": "eslint .",
        "lint:fix": "eslint . --fix",
        "format:check": "prettier --check .",
        "types:fix": "eslint src --fix",
        "depcruise": "depcruise src --config .dependency-cruiser.cjs",
        "depcruise:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot | dot -T svg > dep-graph.svg",
        "depcruise:html": "depcruise src --config .dependency-cruiser.cjs --output-type html"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@clack/prompts": "^1.7.0",
        "@whydrf/eslint-plugin-nava": "^0.1.1",
        "commander": "^15.0.0",
        "execa": "^10.0.0",
        "fs-extra": "^11.3.6",
        "handlebars": "^4.7.8",
        "ora": "^9.4.1",
        "picocolors": "^1.1.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^26.1.1",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitest/eslint-plugin": "^1.0.0",
        "dependency-cruiser": "^18.1.0",
        "eslint": "^9.39.0",
        "eslint-config-next": "^16.0.1",
        "eslint-plugin-perfectionist": "^4.15.0",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-react": "^7.34.0",
        "eslint-plugin-react-hooks": "^5.0.0",
        "prettier": "3.6.2",
        "tsx": "^4.23.1",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.46.0",
        "vitest": "^3.0.0"
    }
}
