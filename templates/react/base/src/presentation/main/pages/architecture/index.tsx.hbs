  files: [
    'Use Cases — One class per operation (Create, Get, Update)',
    'DTOs — Input/output typed shapes',
    'Ports — Receives repository interface via constructor',
  ],
  exampleTitle: 'CreateAccountUseCase',
  example: `import type { CreateAccountDto, AccountDto } from '../../domain';
import type { IAccountRepository } from '../../domain';

export class CreateAccountUseCase {
  constructor(
    private readonly repository: IAccountRepository
  ) {}

  async execute(dto: CreateAccountDto): Promise<AccountDto> {
    return this.repository.create({
      id: crypto.randomUUID(),
      holderName: dto.holderName,
      balance: dto.initialBalance,
      type: dto.type,
    });
  }
}`,
  path: 'src/core/*/application',
};

