import { StrictMode } from "react";
import { createRoot } from "react-dom/client";
{{#if tanstackQuery}}
import { QueryProvider } from "./providers/QueryProvider";
{{/if}}
import { App } from "./App";

createRoot(document.getElementById("root")!).render(
  <StrictMode>
    {{#if tanstackQuery}}
    <QueryProvider>
      <App />
    </QueryProvider>
    {{else}}
    <App />
    {{/if}}
  </StrictMode>,
);
